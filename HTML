egy may become outdated or inaccurate, possibly resulting in losses. Please refer to the most recent prospectus for a more detailed explanation of the Fund's principal risks.</p></div></ngx-web-rich><!----><!----><!----></ngx-web-content-view></div><!----></div><!----></div></div></div></div><ngx-web-urbo _ngcontent-ng-c242032208=""><!----></ngx-web-urbo></div></ngx-web-entity-container><!----><bolt-waiting-indicator _ngcontent-ng-c702955937="" fullscreen="true" starthidden=""></bolt-waiting-indicator></div><ngx-web-urbo _ngcontent-ng-c242032208=""><!----></ngx-web-urbo></div></ngx-web-entity-container></ngx-web-rich-text><!----></ngx-nationwide-rich-text-component><ngx-nationwide-anchor-link _nghost-ng-c3643181541="" id="p73858" item_title="SHARED-Distributions-NFW-9187AO-anchor" view_name="AnchorLink" schema_id="70587" tcmid="tcm:108-73858"><div _ngcontent-ng-c3643181541="" class="anchorLinks"><div _ngcontent-ng-c3643181541="" id="distributions"></div></div><!----></ngx-nationwide-anchor-link><ngx-nationwide-tile-container id="p73876" item_title="Shared-Distributions-Container 2 col" view_name="TilesContainer" schema_id="60721" tcmid="tcm:108-73876"><ngx-web-tile-group _nghost-ng-c3197816916=""><ngx-web-entity-container _ngcontent-ng-c3197816916="" _nghost-ng-c242032208=""><div _ngcontent-ng-c242032208="" class="margin-large"><div _ngcontent-ng-c242032208=""><div _ngcontent-ng-c3197816916="" class="bolt-container"><div _ngcontent-ng-c3197816916="" class="bolt-space-bottom-2xl"><ngx-web-component-header font="secondary" _nghost-ng-c3800000503=""><div _ngcontent-ng-c3800000503="" class="parent-container"><div _ngcontent-ng-c3800000503="" class="bolt-row"><div _ngcontent-ng-c3800000503="" class="bolt-col-12 text-left"><h2 _ngcontent-ng-c3800000503="" class="header bolt-heading-md bolt-space-bottom-md bolt-heading-vibrant-blue bolt-serif">Distributions</h2><!----><div _ngcontent-ng-c3800000503="" class="bolt-space-bottom-sm"><ngx-web-rich _nghost-ng-c4017319325=""><di